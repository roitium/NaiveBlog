{
	"extends": "astro/tsconfigs/base",
	"compilerOptions": {
		"allowJs": true,
		"strictNullChecks": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"paths": {
			"@/data/*": ["data/*"],
			"@/public/*": ["public/*"],
			"@/*": ["src/*"]
		}
	},
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["node_modules", "dist", ".vercel", ".next"]
}
