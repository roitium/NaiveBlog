{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 80,
	"tabWidth": 2,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"endOfLine": "lf",
	"singleAttributePerLine": true,
	"sortPackageJson": false,
	"astro": true,
	"ignorePatterns": [
		"node_modules",
		".astro",
		"dist",
		"src/generated",
		"data/blog",
		"pnpm-lock.yaml",
		"public",
		".wrangler"
	]
}
