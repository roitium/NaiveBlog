# 构建时同步文章仓库，可留空并直接使用本地 data/blog。
GIT_URL=https://github.com/roitium/blog-posts.git
# 私密仓库的只读 GitHub Token；仅用于构建，不要加 PUBLIC_ 前缀。
GIT_TOKEN=

# 公开变量会被编译到浏览器代码中，请勿在 PUBLIC_* 中放置密钥。
PUBLIC_MEMOS_ENDPOINT=https://v2.be.nodal.roitium.com
PUBLIC_LIGHT_GALLERY_LICENSE_KEY=
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPOSITORY_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=

# 可选：部署到子路径，例如 /blog-site；默认部署在域名根目录。
BASE_PATH=

# 兼容旧部署：现有 NEXT_PUBLIC_* 同名变量仍可使用。
# 两者同时存在时，PUBLIC_* 优先。

# Cloudflare 发布凭据请在 CI 环境中配置，不要填写到 PUBLIC_* 中：
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
